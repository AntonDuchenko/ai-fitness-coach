# Server
PORT=4000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ai_fitness_coach

# JWT
JWT_SECRET=your-jwt-secret-change-me
JWT_EXPIRES_IN=15m
# Must differ from JWT_SECRET
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-me
JWT_REFRESH_EXPIRES_IN=30d

# Redis (Bull queue)
REDIS_URL=redis://localhost:6379

# AI Provider
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o

# Stripe (Payments)
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
STRIPE_PRICE_ID_MONTHLY=price_monthly_id
STRIPE_PRICE_ID_ANNUAL=price_annual_id
